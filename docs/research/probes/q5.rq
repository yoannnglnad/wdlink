  VALUES ?a { wd:Q16084618 wd:Q229354 wd:Q1082171 wd:Q21429443 wd:Q7186 wd:Q37463 wd:Q90 wd:Q483020 wd:Q830149 wd:Q162121 wd:Q3181341 wd:Q7191 wd:Q37922 wd:Q80061 wd:Q38104 wd:Q44585 wd:Q11448 wd:Q317949 wd:Q1081068 wd:Q270 wd:Q144488 wd:Q992560 wd:Q1718656 wd:Q209842 wd:Q214654 wd:Q41497113 wd:Q2845896 wd:Q571293  }
  VALUES ?cls { wd:Q5 wd:Q43229 wd:Q2221906 wd:Q618123 wd:Q1656682 wd:Q17537576 wd:Q41710 wd:Q151885 wd:Q4167836 wd:Q101352 wd:Q486972 wd:Q3918 wd:Q2385804 }
  { ?a wdt:P31 ?cls . BIND(0 AS ?d) } UNION
  { ?a wdt:P31/wdt:P279 ?cls . BIND(1 AS ?d) } UNION
