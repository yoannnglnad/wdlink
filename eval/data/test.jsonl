{"id": "test-11", "text": "In 2006 the International Astronomical Union reclassified Pluto as a dwarf planet, a decision prompted by the discovery of Eris.", "mentions": [{"start": 12, "end": 44, "surface": "International Astronomical Union", "qid": "Q6867", "ambiguous": false, "note": "", "wbs_rank": 1, "rest_rank": 1, "api_top1": true, "in_wbs20": true, "in_rest20": true}, {"start": 58, "end": 63, "surface": "Pluto", "qid": "Q339", "ambiguous": true, "note": "dwarf planet, not the Roman god or the Disney dog", "wbs_rank": 1, "rest_rank": 1, "api_top1": true, "in_wbs20": true, "in_rest20": true}, {"start": 69, "end": 81, "surface": "dwarf planet", "qid": "Q2199", "ambiguous": false, "note": "", "wbs_rank": 1, "rest_rank": 1, "api_top1": true, "in_wbs20": true, "in_rest20": true}, {"start": 123, "end": 127, "surface": "Eris", "qid": "Q611", "ambiguous": true, "note": "dwarf planet, not the Greek goddess", "wbs_rank": 7, "rest_rank": 2, "api_top1": false, "in_wbs20": true, "in_rest20": true}]}
{"id": "test-12", "text": "Michael Jordan, a professor at the University of California, Berkeley, is known for his work on machine learning and Bayesian statistics.", "mentions": [{"start": 0, "end": 14, "surface": "Michael Jordan", "qid": "Q3308285", "ambiguous": true, "note": "Michael I. Jordan, computer scientist; popular reading (basketball player Q41421) is wrong", "wbs_rank": 4, "rest_rank": 2, "api_top1": false, "in_wbs20": true, "in_rest20": true}, {"start": 35, "end": 69, "surface": "University of California, Berkeley", "qid": "Q168756", "ambiguous": false, "note": "", "wbs_rank": 1, "rest_rank": 1, "api_top1": true, "in_wbs20": true, "in_rest20": true}, {"start": 96, "end": 112, "surface": "machine learning", "qid": "Q2539", "ambiguous": false, "note": "", "wbs_rank": 1, "rest_rank": 1, "api_top1": true, "in_wbs20": true, "in_rest20": true}, {"start": 117, "end": 136, "surface": "Bayesian statistics", "qid": "Q4874481", "ambiguous": false, "note": "", "wbs_rank": 1, "rest_rank": 1, "api_top1": true, "in_wbs20": true, "in_rest20": true}]}
{"id": "test-13", "text": "Paris abducted Helen from Sparta and took her to Troy, starting the Trojan War described in the Iliad.", "mentions": [{"start": 0, "end": 5, "surface": "Paris", "qid": "Q167646", "ambiguous": true, "note": "Trojan prince, son of Priam; popular reading (French capital) is wrong", "wbs_rank": null, "rest_rank": 3, "api_top1": false, "in_wbs20": false, "in_rest20": true}, {"start": 15, "end": 20, "surface": "Helen", "qid": "Q164061", "ambiguous": true, "note": "Helen of Troy; given-name surface", "wbs_rank": 12, "rest_rank": 1, "api_top1": false, "in_wbs20": true, "in_rest20": true}, {"start": 26, "end": 32, "surface": "Sparta", "qid": "Q5690", "ambiguous": true, "note": "ancient city-state, not modern towns or Sparta Rotterdam", "wbs_rank": 1, "rest_rank": 1, "api_top1": true, "in_wbs20": true, "in_rest20": true}, {"start": 49, "end": 53, "surface": "Troy", "qid": "Q22647", "ambiguous": true, "note": "ancient city, not Troy (Michigan, Alabama...) or the given name", "wbs_rank": 9, "rest_rank": 2, "api_top1": false, "in_wbs20": true, "in_rest20": true}, {"start": 68, "end": 78, "surface": "Trojan War", "qid": "Q42937", "ambiguous": false, "note": "", "wbs_rank": 1, "rest_rank": 1, "api_top1": true, "in_wbs20": true, "in_rest20": true}, {"start": 96, "end": 101, "surface": "Iliad", "qid": "Q8275", "ambiguous": false, "note": "", "wbs_rank": 1, "rest_rank": 1, "api_top1": true, "in_wbs20": true, "in_rest20": true}]}
