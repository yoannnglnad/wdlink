{"id": "test-19", "text": "The Riverbend Jaguar Census filmed a jaguar hunting yacare caimans in the Pantanal, the largest tropical wetland in the world.", "mentions": [{"start": 4, "end": 27, "surface": "Riverbend Jaguar Census", "qid": null, "ambiguous": false, "note": "NIL: invented monitoring project"}, {"start": 37, "end": 43, "surface": "jaguar", "qid": "Q35694", "ambiguous": true, "note": "the animal, not the car marque", "wbs_rank": 4, "rest_rank": 1, "api_top1": false, "in_wbs20": true, "in_rest20": true}, {"start": 52, "end": 66, "surface": "yacare caimans", "qid": "Q756678", "ambiguous": false, "note": "species Caiman yacare", "wbs_rank": null, "rest_rank": 1, "api_top1": false, "in_wbs20": false, "in_rest20": true}, {"start": 74, "end": 82, "surface": "Pantanal", "qid": "Q157603", "ambiguous": true, "note": "the wetland, not the telenovela or the Brazilian mesoregion", "wbs_rank": 1, "rest_rank": 1, "api_top1": true, "in_wbs20": true, "in_rest20": true}]}
